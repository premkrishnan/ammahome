# ============================================================
# FILE: .env.example
#
# PURPOSE:
#   Template showing every environment variable AmmaHome needs.
#   Copy this file to .env and fill in your real values.
#   NEVER commit .env to git — it contains secrets.
#
# HOW TO USE:
#   cp .env.example .env
#   Then edit .env with your real values.
#
# AUTHOR: AmmaHome
# LAST UPDATED: 2026-05-27
# ============================================================

# ── Telegram ──────────────────────────────────────────────────
# Get this from @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# The chat ID of your family Telegram group
# How to find it: add @userinfobot to the group, it will reply with the ID
# It will be a negative number like: -1001234567890
FAMILY_GROUP_CHAT_ID=-1001234567890

# ── Display Server ────────────────────────────────────────────
# IMPORTANT: Always set this to 0.0.0.0 (not your Mac's IP)
# The server must listen on all interfaces to accept connections
DISPLAY_SERVER_HOST=0.0.0.0

# Single port for both HTTP and WebSocket (/ws path).
# On Railway this is set automatically — do not set it there.
# Locally: iPad opens http://<mac-ip>:8080 and WS connects to ws://<mac-ip>:8080/ws
PORT=8080

# ── Reminder & Heartbeat ──────────────────────────────────────
# How often (in seconds) to chime if Amma hasn't acknowledged
# Default: 900 = 15 minutes
REMINDER_INTERVAL_SECONDS=900

# How often (in seconds) the iPad sends a heartbeat ping
# Default: 300 = 5 minutes
HEARTBEAT_INTERVAL_SECONDS=300

# Alert family if no heartbeat received for this many minutes
# Default: 15 minutes
HEARTBEAT_TIMEOUT_MINUTES=15

# ── TTS (Text-to-Speech) ──────────────────────────────────────
# Language for reading text messages aloud to Amma
# "ml" = Malayalam (default), "en" = English
TTS_LANGUAGE=ml

# TTS backend to use
# "google" = gTTS (requires internet, supports Malayalam)
# "say"    = macOS built-in (English only, works offline)
TTS_BACKEND=google

# ── Media Queue ───────────────────────────────────────────────
# Max messages to queue if iPad is offline (so nothing is lost)
MAX_MEDIA_QUEUE_SIZE=10

# ── Family Members ────────────────────────────────────────────
# Maps Telegram user_id to display name shown on Amma's screen
# Format: JSON object with string keys and string values
# How to find user_id: message @userinfobot on Telegram
# Example: {"123456789": "Prem", "987654321": "Priya", "111222333": "Dubai Sibling"}
FAMILY_MEMBER_NAMES={"000000000": "Prem"}
